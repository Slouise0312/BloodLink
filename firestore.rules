rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ──────────────────────────────────────────────────────────────
    // Users can READ their own doc.
    // Users can CREATE their own doc (first sign-up) but CANNOT set role to STAFF/ADMIN.
    // Users can UPDATE their own doc but CANNOT change: role, orgId, createdAt.
    // Only Cloud Functions or Firebase Admin SDK (server-side) can change role/orgId.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // First-time profile creation — role must be APPLICANT
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'APPLICANT';

      // Updates — only block role changes (the critical security check)
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;

      // Users can delete their own profile (RA 10173 Right to Erasure)
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── ALERTS ─────────────────────────────────────────────────────────────
    match /users/{userId}/alerts/{alertId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && (request.auth.uid == userId
            || (exists(path('databases', database, 'documents', 'users', request.auth.uid))
                && (get(path('databases', database, 'documents', 'users', request.auth.uid)).data.get('role', '') == 'STAFF'
                    || get(path('databases', database, 'documents', 'users', request.auth.uid)).data.get('role', '') == 'ADMIN')));
    }

    // ── ORGANIZATIONS ──────────────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if request.auth != null
        && get(path('databases', database, 'documents', 'users', request.auth.uid)).data != null
        && get(path('databases', database, 'documents', 'users', request.auth.uid)).data.orgId == orgId;
      allow write: if false;
    }

    // ── EVENTS ─────────────────────────────────────────────────────────────
    // Only STAFF or ADMIN can create events (not APPLICANT)
    match /events/{eventId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && exists(path('databases', database, 'documents', 'users', request.auth.uid))
        && (get(path('databases', database, 'documents', 'users', request.auth.uid)).data.get('role', '') == 'STAFF'
            || get(path('databases', database, 'documents', 'users', request.auth.uid)).data.get('role', '') == 'ADMIN');

      allow update, delete: if request.auth != null
        && (
          resource.data.get('createdByUid', '') == request.auth.uid
          || (exists(path('databases', database, 'documents', 'users', request.auth.uid))
              && get(path('databases', database, 'documents', 'users', request.auth.uid)).data != null
              && (
                get(path('databases', database, 'documents', 'users', request.auth.uid)).data.get('role', '') == 'ADMIN'
                || (get(path('databases', database, 'documents', 'users', request.auth.uid)).data.get('role', '') == 'STAFF'
                    && get(path('databases', database, 'documents', 'users', request.auth.uid)).data.get('orgId', '') == resource.data.get('orgId', ''))
              ))
        );
    }

    // ── SCREENINGS ─────────────────────────────────────────────────────────
    match /screenings/{screeningId} {
      allow read, update: if request.auth != null && (
        resource.data.applicantUid == request.auth.uid
        || (get(path('databases', database, 'documents', 'users', request.auth.uid)).data != null
            && get(path('databases', database, 'documents', 'users', request.auth.uid)).data.orgId == resource.data.orgId)
      );
      allow create: if request.auth != null && request.resource.data.applicantUid == request.auth.uid;
      // Users can delete their own screenings (RA 10173 Right to Erasure)
      allow delete: if request.auth != null && resource.data.applicantUid == request.auth.uid;
    }
  }
}
